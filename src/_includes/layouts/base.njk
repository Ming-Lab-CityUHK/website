<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ site.description }}">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="preload" href="/assets/fonts/ibm-plex-sans-400-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/ibm-plex-sans-600-latin.woff2" as="font" type="font/woff2" crossorigin>
</head>
<body>

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/">
      <span class="brand-name">{{ site.name }}</span>
    </a>
    <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav">
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="visually-hidden">Menu</span>
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul>
        {% for item in site.nav %}
        <li>
          <a href="{{ item.url }}"
             {% if page.url == item.url %}aria-current="page"{% endif %}>{{ item.label }}{% if page.url == item.url %}<span class="nav-underline"></span>{% endif %}</a>
        </li>
        {% endfor %}
      </ul>
    </nav>
  </div>
</header>

{% if hero %}
<section class="hero">
  <div class="hero-media"{% if heroImage %} style="background-image: url('{{ heroImage }}')"{% endif %}>
    {% if not heroImage %}
    <span class="hero-placeholder">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <rect x="3" y="5" width="18" height="14" rx="2"></rect>
        <circle cx="8.5" cy="10" r="1.5"></circle>
        <path d="M3 16.5l4.5-3.5 3.5 2.5 3-2 7 5"></path>
      </svg>
      {% if heroLabel %}{{ heroLabel }}{% endif %}
    </span>
    {% endif %}
  </div>
  <div class="hero-content">
    <h1 class="hero-title">{{ title }}</h1>
  </div>
</section>
{% endif %}

<main class="{{ "full-bleed" if fullBleed else "container" }}{{ " is-centered" if centered }}">
  {{ content | safe }}
</main>

<footer class="site-footer">
  <div class="footer-inner">
    <p class="footer-copy">© 2026 {{ site.name }}. Built by Fabian.</p>

    <a class="footer-github" href="{{ site.repo }}" aria-label="{{ site.name }} website source on GitHub">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.96 0-1.32.47-2.39 1.24-3.23-.13-.3-.54-1.53.12-3.18 0 0 1.01-.32 3.3 1.23a11.4 11.4 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.65.25 2.88.12 3.18.77.84 1.24 1.91 1.24 3.23 0 4.63-2.81 5.65-5.49 5.95.43.37.82 1.1.82 2.22v3.29c0 .32.22.7.83.58A12.01 12.01 0 0 0 24 12.5C24 5.87 18.63.5 12 .5z"/></svg>
    </a>

    <a class="footer-logo" href="https://www.cityu.edu.hk/bms/">
      <img src="/assets/bms-logo.png" width="800" height="203"
           alt="Department of Biomedical Sciences, City University of Hong Kong">
    </a>
  </div>
</footer>

<script src="/js/nav.js"></script>
</body>
</html>
