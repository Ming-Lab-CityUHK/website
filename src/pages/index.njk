---
layout: layouts/base.njk
title: Home
description: Ming Lab at City University of Hong Kong studies cancer mechanisms, epigenetics, spatial tumor-nerve interactions and AI-assisted approaches for translational cancer research.
permalink: /
fullBleed: true
---
<section class="home-hero">
  <video class="home-hero-video" src="/assets/videos/20260911.mp4"
         autoplay muted loop playsinline preload="auto" aria-hidden="true"></video>
  <div class="home-hero-inner">
    <div>
      <p class="home-label">Department of Biomedical Sciences · CityUHK</p>
      <h1>Where cancer epigenetics meets advanced technologies</h1>
      <p class="home-lede">We investigate how genetic, epigenetic and spatial tissue-level mechanisms shape cancer progression, combining wet-lab molecular experiments with bioinformatics and AI-assisted analysis</p>
    </div>

    <aside class="home-summary" aria-label="Lab summary">
      <p>Areas of Study</p>
      <p>Cancer Biology, Epigenetics, CRISPR Technology, Cancer Neuroscience, Spatial Biology, Digital Pathology</p>
      <a href="/research/">Research</a>
      <a href="/members/">Explore our Team</a>
      <a href="/contact/">Contact</a>
    </aside>
  </div>
</section>

<section class="home-feature">
  <div class="home-feature-inner">
    <div class="home-feature-copy">
      <p class="home-number">01</p>
      <h2>Latest News</h2>
    </div>

    <div class="home-news-list">
      {% for item in news.items %}
      {% if loop.index <= 3 %}
      <article class="home-news">
        {% if item.image %}
        <img class="home-news-media" src="{{ item.image }}" alt="{{ item.alt }}" loading="lazy">
        {% else %}
        <div class="home-news-media home-image-placeholder"><span>Image placeholder</span></div>
        {% endif %}
        <div class="home-news-body">
          <h3>{{ item.title }}</h3>
          <p class="home-news-date"><time datetime="{{ item.date }}">{{ item.date | readableDate }}</time></p>
          <p class="home-news-excerpt">{{ item.excerpt }}</p>
          {% if item.url %}<a class="home-news-more" href="{{ item.url }}" target="_blank" rel="noopener">Learn more</a>{% endif %}
        </div>
      </article>
      {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<section class="home-section">
  <div class="home-section-inner">
    <p class="home-number">02</p>
    <h2>[Section placeholder]</h2>
    <p class="home-placeholder-copy">[Content placeholder]</p>
  </div>
</section>

<section class="home-section">
  <div class="home-section-inner">
    <p class="home-number">03</p>
    <h2>Selected Publications</h2>

    <div class="home-publication-list">
      {% for paper in publications.papers %}
      {% if paper.doi in [
        "10.1126/sciadv.adx4982",
        "10.1016/j.celrep.2025.116596",
        "10.1038/s41392-020-00219-2"
      ] %}
      {% set link = paper.url if paper.url else "https://doi.org/" + paper.doi %}
      <article class="home-publication">
        <p class="home-publication-year">{{ paper.year }}</p>
        <h3><a href="{{ link }}" target="_blank" rel="noopener">{{ paper.title }}</a></h3>
        <p>{{ paper.journal }}</p>
      </article>
      {% endif %}
      {% endfor %}
    </div>

    <p class="home-more"><a href="/publications/">All publications</a></p>
  </div>
</section>

<section class="home-contact">
  <div class="home-section-inner home-contact-inner">
    <div class="home-image-placeholder" aria-label="Group photo placeholder">
      <span>Group photo placeholder</span>
    </div>
    <div>
      <p class="home-number">04</p>
      <h2>Explore our Team</h2>
      <p>Learn more about the people, research interests and alumni of Ming Lab.</p>
      <a href="/members/">Team members</a>
    </div>
  </div>
</section>
