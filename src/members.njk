---
layout: layouts/base.njk
title: Members
permalink: /members/
hero: true
heroLabel: Group photo
fullBleed: true
---
<section class="pi-band">
  <div class="pi-band-inner">
    <div class="pi-photo">
      <img src="/assets/mc.png" width="600" height="800" alt="Prof. Chan Kui Ming">
    </div>

    <div class="pi-caption">
      <h2 class="pi-name">Prof. CHAN, Kui Ming</h2>
      <p class="pi-role">Associate Professor</p>
    </div>

    <div class="pi-bio">
      <p>Prof. K. M. Chan completed his BSc and PhD in the Department of Biochemistry at the University of Hong Kong. He then pursued his scientific research career at Mayo Clinic (Rochester, MN, USA), where he studied the role of epigenetics in gene regulation under physiological and pathological conditions and was awarded the prestigious Edward C. Kendall Research Fellowship in Biochemistry. After completing his postdoctoral training, he returned to Hong Kong and joined the Department of Biomedical Sciences (BMS) at City University of Hong Kong in 2015.</p>

      <p>Building on this foundation in epigenetics, Prof. Chan’s laboratory investigates genetic and epigenetic factors in human health and disease. Our ultimate goal is to deliver molecular insight into how specific histone- and chromatin-modifying complexes can be controlled, and to translate these scientific discoveries into novel therapeutic strategies. Our core research focuses include the mechanisms underlying pancreatic ductal adenocarcinoma (PDAC), breast cancer, and hepatocellular carcinoma (HCC). We are also investigating the regulation of X chromosome inactivation and paraspeckles by integrating CRISPR-Cas9 with multi-omics technologies.</p>

      <p>More recently, our research has expanded to include perineural invasion in cancer, spatial omics, and the application of AI in digital pathology.</p>
    </div>
  </div>
</section>

<section class="members-list">
  <div class="members-inner">
    {% for group in members.groups %}
    <section class="member-group">
      <h2 class="members-heading">{{ group.title }}</h2>

      {% if not group.people.length %}
      <div class="member-list-empty"></div>

      {% elif group.layout == "grid" %}
      <ul class="former-list">
        {% for person in group.people %}
        <li class="former">
          <div class="former-photo">
            {% if person.photo %}
            <img src="{{ person.photo }}" alt="{{ person.name }}">
            {% else %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <circle cx="12" cy="8.5" r="3.5"></circle>
              <path d="M4.5 20a7.5 7.5 0 0 1 15 0"></path>
            </svg>
            {% endif %}
          </div>
          <div class="former-body">
            <h3 class="former-name">{{ person.name }}</h3>
            {% if person.role %}<p class="former-meta">{{ person.role }}</p>{% endif %}
            {% if person.years %}<p class="former-meta">{{ person.years }}</p>{% endif %}
            {% if person.note %}<p class="former-meta">{{ person.note }}</p>{% endif %}
          </div>
        </li>
        {% endfor %}
      </ul>

      {% else %}
      <ul class="member-list">
        {% for person in group.people %}
        <li class="member">
          <div class="member-photo">
            {% if person.photo %}
            <img src="{{ person.photo }}" alt="{{ person.name }}">
            {% else %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <circle cx="12" cy="8.5" r="3.5"></circle>
              <path d="M4.5 20a7.5 7.5 0 0 1 15 0"></path>
            </svg>
            {% endif %}
          </div>

          {% if person.joined %}
          <p class="member-year">Joined {{ person.joined }}</p>
          {% endif %}

          <div class="member-body">
          <div class="member-header">
            <h3 class="member-name">{{ person.name }}</h3>

            {% set l = person.links %}
            {% if l and (l.github or l.scholar or l.linkedin or l.email) %}
            <ul class="member-links">
              {% if l.github %}
              <li><a href="{{ l.github }}" target="_blank" rel="noopener" aria-label="{{ person.name }} on GitHub">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.96 0-1.32.47-2.39 1.24-3.23-.13-.3-.54-1.53.12-3.18 0 0 1.01-.32 3.3 1.23a11.4 11.4 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.65.25 2.88.12 3.18.77.84 1.24 1.91 1.24 3.23 0 4.63-2.81 5.65-5.49 5.95.43.37.82 1.1.82 2.22v3.29c0 .32.22.7.83.58A12.01 12.01 0 0 0 24 12.5C24 5.87 18.63.5 12 .5z"/></svg>
              </a></li>
              {% endif %}
              {% if l.scholar %}
              <li><a href="{{ l.scholar }}" target="_blank" rel="noopener" aria-label="{{ person.name }} on Google Scholar">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 3 1 9l11 6 9-4.91V17h2V9L12 3z"/><path d="M5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82z"/></svg>
              </a></li>
              {% endif %}
              {% if l.linkedin %}
              <li><a href="{{ l.linkedin }}" target="_blank" rel="noopener" aria-label="{{ person.name }} on LinkedIn">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/></svg>
              </a></li>
              {% endif %}
              {% if l.email %}
              <li><a href="mailto:{{ l.email }}" aria-label="Email {{ person.name }}">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M2 6a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v.35l-10 5.5L2 6.35V6z"/><path d="M2 8.63V18a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8.63l-9.52 5.23a1 1 0 0 1-.96 0L2 8.63z"/></svg>
              </a></li>
              {% endif %}
            </ul>
            {% endif %}
          </div>

          <div class="member-bio">
            {% if person.interests and person.interests.length %}
            <p class="member-field">
              <span class="member-label">Research interests</span>
              {{ person.interests | join(" · ") }}
            </p>
            {% endif %}
            {% if person.projects and person.projects.length %}
            <p class="member-field">
              <span class="member-label">Current projects</span>
              {{ person.projects | join(" · ") }}
            </p>
            {% endif %}
            {% if person.blurb %}
            <p class="member-field">{{ person.blurb }}</p>
            {% endif %}
          </div>
          </div>
        </li>
        {% endfor %}
      </ul>
      {% endif %}
    </section>
    {% endfor %}
  </div>
</section>
